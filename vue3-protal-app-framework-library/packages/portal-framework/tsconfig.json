{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "importHelpers": true,
    "strict": false,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictNullChecks": false,
    "sourceMap": false,
    "declaration": true,
    "removeComments": false,
    "allowJs": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "DOM",
      "dom.iterable"
    ],
    "noEmit": false,
    "outDir": "./dist",
    "declarationDir": "dist/types",
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "shims.d.ts",
    "global.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
